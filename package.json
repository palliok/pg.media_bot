{
  "name": "pg.media_bot",
  "version": "2.0.0",
  "description": "telegram bot for media team in the 'Mountain of the Worship' Church",
  "main": "index.ts",
  "scripts": {
    "prebuild": "rimraf ./dist/*",
    "build": "tsc -p . && npx tsc-alias",
    "start:dev": "nodemon",
    "start:prod": "node dist/index.js",
    "start:docker": "node index.js",
    "docker-amd": "npm run build && docker buildx build --platform linux/amd64 --tag 1442/pg.media_bot:v0.48 .",
    "docker-arm": "npm run build && docker build --tag 1442/pg.media_bot:v0.47 ."
  },
  "author": {
    "name": "palliok",
    "email": "paul.sukharev.s@gmail.com"
  },
  "license": "ISC",
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/ffmpeg": "^1.0.7",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^20.14.2",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.8",
    "axios": "^1.9.0",
    "canvas": "^3.1.0",
    "dotenv": "^16.5.0",
    "ffmpeg": "^0.0.4",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^140.0.0",
    "moment": "^2.30.1",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "tsx": "^4.19.1"
  }
}
